<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Buyer.master.cs" Inherits="Exchangebase.Com.Buyer.Buyer" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <link href="resources/main.min.css" rel="stylesheet" />
    <link href="resources/print.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.2.1.min.js" integrity="sha256-hwg4gsxgFZhOsEEamdOYGBf13FyQuiTwlAQgxVSNgt4=" crossorigin="anonymous"></script>
    <script type="text/javascript" src="resources/main.min.js"></script>
    <style>
        /*.fade-in {
    animation: animationFrames1 ease 1s;
    animation-iteration-count: 1;
    transform-origin: 50% 50%;
    animation-fill-mode: forwards; /*when the spec is finished
    -webkit-animation: animationFrames1 ease 1s;
    -webkit-animation-iteration-count: 1;
    -webkit-transform-origin: 50% 50%;
    -webkit-animation-fill-mode: forwards; /*Chrome 16+, Safari 4+
    -moz-animation: animationFrames1 ease 1s;
    -moz-animation-iteration-count: 1;
    -moz-transform-origin: 50% 50%;
    -moz-animation-fill-mode: forwards; /*FF 5+
    -o-animation: animationFrames1 ease 1s;
    -o-animation-iteration-count: 1;
    -o-transform-origin: 50% 50%;
    -o-animation-fill-mode: forwards; /*Not implemented yet
    -ms-animation: animationFrames1 ease 1s;
    -ms-animation-iteration-count: 1;
    -ms-transform-origin: 50% 50%;
    -ms-animation-fill-mode: forwards; /*IE 10+
}*/
        .fade-in {
   
    animation: fadein .75s;
    -moz-animation: fadein .75s; /* Firefox */
    -webkit-animation: fadein .75s; /* Safari and Chrome */
    -o-animation: fadein .75s; /* Opera */
}

/*.img-holder img { 
    width: 100%;
}*/
@keyframes fadein {
    from {
        opacity:0;
    }
    to {
        opacity:1;
    }
}
@-moz-keyframes fadein { /* Firefox */
    from {
        opacity:0;
    }
    to {
        opacity:1;
    }
}
@-webkit-keyframes fadein { /* Safari and Chrome */
    from {
        opacity:0;
    }
    to {
        opacity:1;
    }
}
@-o-keyframes fadein { /* Opera */
    from {
        opacity:0;
    }
    to {
        opacity: 1;
    }
}

        .settingsLogout {
            text-transform: uppercase;
            background: transparent;
            border: 0;
            color: #d7dce1;
            line-height: normal;
            margin: 0;
            padding: 0;

        }
            .settingsLogout:hover {
                font-weight:600;
                color:white;
                cursor:pointer;
            }
        .lb-number {
            display: none !important;
        }
              .nav-background-elements {
    background-image: url(images/new_logo.png), url(images/full-gradient.png), url(images/img1.jpg), url(images/img2.jpg);
    background-position: top center,center,left 60%,right;
    background-repeat: no-repeat;
    background-size: auto 80px,cover,35%, 35%;
}
.nav-height-element {
    height:80px;
}

.dropdown-menu {
    min-width: 8rem;
}
   .settingsLogout {
        color: #6d6d6d;
    }
    header nav.navbar-dark .navbar-toggler {
        border: none;
        background-color: #0000004a;
        margin-left: 12px;
    }
    .navbar-collapse {
            background: linear-gradient(to top, #FFFFFF,#ffffffc4, #ffffff00);
    }
    .settingsLogout {
        font-weight:600;
    }

@media screen and (min-width: 991px) {
        nav.sidebar {
        top: 80px;
        padding:12px;
    }
}
@media screen and (max-width: 991px) {
    header nav.navbar #mainNav {
        border-top: none !important;
    }
}
@media (min-width: 600px) and (max-width: 990px) {
        nav.sidebar {
        top: -12px;
    }
}

@media (min-width: 450px) and (max-width: 600px) {
    .nav-height-element {
        height:60px;
    }
    .nav-background-elements {
        background-size: auto 60px,cover,35%, 35%;
    }
    nav.sidebar {
        top: -32px;
    }
}
@media only screen and (max-width: 450px) {
    .nav-height-element {
         height:60px;
    }
    .nav-background-elements {
        background-size: auto 48px,cover,35%, 35%;
        background-position: center 5px,center,left 60%,right;
    }
    nav.sidebar {
        top: -28px;
    }
}
@media only screen and (max-width: 400px) {
    nav.sidebar {
        top: -20px;
    }
}
@media only screen and (max-width: 370px) {
    nav.sidebar {
        top: -10px;
    }
}

    </style>
    <title>ExchangeBase Data Room</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server" >
        <asp:ScriptManager ID="ScriptManager1" runat="server" />
        <header class="fixed-top bg-dark_blue nav-background-elements" style="background-color:#FFF;">
            <nav class="navbar navbar-expand-lg navbar-dark bg-faded" style="padding:0px;">
                <button runat="server" id="HamburgerButton" class="navbar-toggler navbar-toggler-right" type="button" data-toggle="collapse" data-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="col-2 d-none d-lg-inline-block"></div>
                <a class="col-8 text-center nav-img d-lg-inline-block" href="MyProjectsNew.aspx">
                    <div class="nav-height-element"></div>
                </a>
                <div class="dropdown d-none d-lg-inline-block" style="position:absolute;right:20px;">
                        <span class="welcome dropdown-toggle p-2" id="accountAction" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-hidden="true" style="background-color: #00000024;">
                            <i class="fa fa-user mr-2" aria-hidden="true"></i>
                            <strong>
                                <asp:Label runat="server" ID="UserNameLabel"></asp:Label></strong></span>
                        <div class="dropdown-menu" aria-labelledby="accountAction">
                            <asp:Button runat="server" ID="settingsButton" class="dropdown-item" href="#" Text="Settings"></asp:Button>
                            <asp:Button runat="server" ID="logoutButton" class="dropdown-item" href="#" Text="Logout"></asp:Button>
                        </div>
                    </div>
                <asp:Panel runat="server" class="collapse navbar-collapse mt-2 mt-lg-0 fade-in pl-3" ID="mainNav">
                    <ul class="navbar-nav d-inline-block d-lg-none">
                        <li runat="server" id="SettingPageLi" class="nav-item"><a class="nav-link mx-2 pb-2" href="#">  
                            <asp:Button CssClass="settingsLogout" runat="server" ID="settingsButton2"  href="#" Text="Settings"></asp:Button>
                             </a></li>
                        <li class="nav-item"><a class="nav-link mx-2 pb-2" href="#">
                            <asp:Button CssClass="settingsLogout" runat="server" ID="logoutButton2"  href="#" Text="Logout"></asp:Button>
                            </a></li>
                    </ul>
                </asp:Panel>
            </nav>

        </header>

        <div class="container-fluid">
            <div class="row fade-in">

                <asp:ContentPlaceHolder ID="sidebar" runat="server" >
                </asp:ContentPlaceHolder>
        
                <asp:ContentPlaceHolder ID="body" runat="server">

                    <asp:ContentPlaceHolder ID="list" runat="server">
                    </asp:ContentPlaceHolder>

                </asp:ContentPlaceHolder>

                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>

            </div>
        </div>

    </form>

    <script type="text/javascript">
        $('.lb-number').remove();
    </script>
</body>
</html>